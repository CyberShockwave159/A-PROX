# Build artifacts (cargo target dir is 3.9GB when built)
/target

# Runtime state (recreated on startup by VectorStore::create_dir_all)
/data

# Downloaded model binaries (fetch via scripts/download_model.sh)
/models

# SearXNG virtualenv (created by scripts/download_searxng.sh / the manager)
/searxng/.venv/

# Local overrides & secrets
/.env
/.env.*
config/local.toml

# Machine-specific config (real keys/paths); the tracked version is sanitized
config/default.toml

# Stray image-gen exports — canonical copies live in prompts/ and workflows/
/t-iprompt.txt
/i-iprompt.txt
/Custom Qwen Image 2.1 (GGUF) Image-to-Image.json
/Custom Qwen Image 2.1 (GGUF) Text-to-Image.json

# Desktop junk
/.directory

# Editor/OS noise
*.swp
.DS_Store
*.log